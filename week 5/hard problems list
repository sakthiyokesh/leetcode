1.   895. Maximum Frequency Stack
   


from collections import defaultdict

class FreqStack:

    def __init__(self):
        # Maps an element to its overall frequency
        self.freq_map = defaultdict(int)
        
        # Maps a frequency level to a list/stack of elements at that frequency
        self.group_map = defaultdict(list)
        
        # Tracks the maximum frequency currently in the stack
        self.max_freq = 0

    def push(self, val: int) -> None:
        # Increment frequency of the element
        self.freq_map[val] += 1
        curr_freq = self.freq_map[val]
        
        # Update max_freq if a new peak is reached
        if curr_freq > self.max_freq:
            self.max_freq = curr_freq
            
        # Add the element to the bucket corresponding to its current frequency
        self.group_map[curr_freq].append(val)

    def pop(self) -> int:
        # Pop the element closest to the top from the highest frequency group
        val = self.group_map[self.max_freq].pop()
        
        # Decrement the item's individual frequency tracker
        self.freq_map[val] -= 1
        
        # If the highest frequency group is now empty, decrement max_freq
        if not self.group_map[self.max_freq]:
            self.max_freq -= 1
            
        return val


2.          1691. Maximum Height by Stacking Cuboids





class Solution:
    def maxHeight(self, cuboids: list[list[int]]) -> int:
        # Step 1: Orient each cuboid so that width <= length <= height
        for c in cuboids:
            c.sort()
            
        # Step 2: Sort all cuboids. This guarantees that if cuboid i 
        # can go on top of cuboid j, i will appear before j in the sorted list.
        cuboids.sort()
        
        n = len(cuboids)
        # dp[i] stores the maximum height of a stack ending with cuboid i at the bottom
        dp = [0] * n
        
        # Step 3: Compute LIS (Longest Increasing Subsequence) based on height sums
        for i in range(n):
            # Base case: the single cuboid i itself forms a valid stack
            dp[i] = cuboids[i][2]
            
            # Look at all previously processed cuboids that can sit on top of i
            for j in range(i):
                # Condition: cuboid j dimensions must be smaller or equal to cuboid i
                if (cuboids[j][0] <= cuboids[i][0] and 
                    cuboids[j][1] <= cuboids[i][1] and 
                    cuboids[j][2] <= cuboids[i][2]):
                    
                    dp[i] = max(dp[i], dp[j] + cuboids[i][2])
                    
        # The answer is the absolute maximum height achieved across all stack configurations
        return max(dp)


3.          936. Stamping The Sequence


class Solution:
    def movesToStamp(self, stamp: str, target: str) -> list[int]:
        M, N = len(stamp), len(target)
        target_chars = list(target)
        stamp_chars = list(stamp)
        
        # A target string filled entirely with '?' represents the starting state in reverse
        reversed_start_state = ['?'] * N
        res = []
        
        # Track whether we made a change in the current sweep
        changed = True
        
        # Helper function to check if stamp can match target starting at index 'i'
        def can_match(i: int) -> bool:
            matched_any_char = False
            for j in range(M):
                # '?' acts as a wildcard, matching any character in the stamp
                if target_chars[i + j] == '?':
                    continue
                # If a real character doesn't match the stamp, it's an invalid position
                if target_chars[i + j] != stamp_chars[j]:
                    return False
                matched_any_char = True
            
            # We must match at least one non-'?' character to avoid an infinite loop
            return matched_any_char

        # Helper function to turn a matched segment into '?' wildcards
        def do_stamp(i: int) -> int:
            count = 0
            for j in range(M):
                if target_chars[i + j] != '?':
                    target_chars[i + j] = '?'
                    count += 1
            return count

        # While changes are being made and we haven't completely cleared the string
        while changed and target_chars != reversed_start_state:
            changed = False
            
            # Try to place the stamp at every possible valid starting index
            for i in range(N - M + 1):
                if can_match(i):
                    do_stamp(i)
                    res.append(i)
                    changed = True
                    # Break out early to restart checking positions with new wildcards available
                    break
                    
        # If the string was completely reverted to '?', return the forward sequence of actions
        if target_chars == reversed_start_state:
            return res[::-1]
            
        return []

4.          224. Basic Calculator



class Solution:
    def calculate(self, s: str) -> int:
        stack = []
        current_result = 0
        current_number = 0
        sign = 1  # 1 represents '+', -1 represents '-'
        
        i = 0
        n = len(s)
        
        while i < n:
            char = s[i]
            
            if char.isdigit():
                # Formulate multi-digit numbers
                current_number = 0
                while i < n and s[i].isdigit():
                    current_number = current_number * 10 + int(s[i])
                    i += 1
                # Add the complete number multiplied by its sign to the result
                current_result += sign * current_number
                # Re-adjust index pointer because the inner loop advanced it
                i -= 1
                
            elif char == '+':
                sign = 1
                
            elif char == '-':
                sign = -1
                
            elif char == '(':
                # Push the current running result and sign onto the stack
                stack.append(current_result)
                stack.append(sign)
                # Reset tracking values for the new sub-expression context
                current_result = 0
                sign = 1
                
            elif char == ')':
                # Pop the active sign before the parenthesis group
                prev_sign = stack.pop()
                # Pop the running result before the parenthesis group
                prev_result = stack.pop()
                
                # Combine the current inner sub-total with the outer expression context
                current_result = prev_result + (prev_sign * current_result)
                
            i += 1
            
        return current_result

5.          321. Create Maximum Number



class Solution:
    def maxNumber(self, nums1: list[int], nums2: list[int], k: int) -> list[int]:
        m, n = len(nums1), len(nums2)
        best_combination = []
        
        # Helper: Extract the maximum possible subsequence of length 'size' from 'nums'
        def get_max_subsequence(nums: list[int], size: int) -> list[int]:
            stack = []
            drop_allowed = len(nums) - size
            
            for digit in nums:
                # Maintain a decreasing monotonic stack
                while drop_allowed > 0 and stack and stack[-1] < digit:
                    stack.pop()
                    drop_allowed -= 1
                stack.append(digit)
                
            # If we still have more elements than needed, slice down to 'size'
            return stack[:size]
            
        # Helper: Merge two lists to get the largest possible lexicographical result
        def merge(sub1: list[int], sub2: list[int]) -> list[int]:
            res = []
            i, j = 0, 0
            # Slicing comparison sub1[i:] > sub2[j:] automatically breaks ties 
            # by looking ahead to find the larger subsequent element.
            while i < len(sub1) and j < len(sub2):
                if sub1[i:] > sub2[j:]:
                    res.append(sub1[i])
                    i += 1
                else:
                    res.append(sub2[j])
                    j += 1
            # Append remaining elements
            res.extend(sub1[i:])
            res.extend(sub2[j:])
            return res

        # Try every valid number of elements to take from nums1
        # i elements from nums1 leaves (k - i) elements to be taken from nums2
        start = max(0, k - n)
        end = min(k, m)
        
        for i in range(start, end + 1):
            sub1 = get_max_subsequence(nums1, i)
            sub2 = get_max_subsequence(nums2, k - i)
            candidate = merge(sub1, sub2)
            # Track the absolute largest sequence seen
            if candidate > best_combination:
                best_combination = candidate
                
        return best_combination



6.              726. Number of Atoms




from collections import defaultdict

class Solution:
    def countOfAtoms(self, formula: str) -> str:
        # Stack contains frequency dictionaries. 
        # The base layer tracks global element frequencies.
        stack = [defaultdict(int)]
        
        i = 0
        n = len(formula)
        
        while i < n:
            if formula[i] == '(':
                # Start a new nested layer
                stack.append(defaultdict(int))
                i += 1
                
            elif formula[i] == ')':
                i += 1
                # Parse the multiplier following the closing parenthesis
                start_idx = i
                while i < n and formula[i].isdigit():
                    i += 1
                
                # If no digit follows, the multiplier defaults to 1
                multiplier = int(formula[start_idx:i]) if start_idx < i else 1
                
                # Pop the nested layer map and multiply its values
                nested_map = stack.pop()
                for atom, count in nested_map.items():
                    stack[-1][atom] += count * multiplier
                    
            else:
                # Parse the Atom name (Starts with Uppercase, followed by lowercase letters)
                start_idx = i
                i += 1  # Move past the uppercase letter
                while i < n and formula[i].islower():
                    i += 1
                atom = formula[start_idx:i]
                
                # Parse the count following this specific atom
                start_idx = i
                while i < n and formula[i].isdigit():
                    i += 1
                atom_count = int(formula[start_idx:i]) if start_idx < i else 1
                
                # Add the parsed atom to the current top layer map
                stack[-1][atom] += atom_count
                
        # The final remaining map at the bottom of the stack holds all global frequencies
        final_map = stack[0]
        
        # Sort atoms alphabetically as required by the output description
        sorted_atoms = sorted(final_map.keys())
        
        # Build the resulting output string
        result = []
        for atom in sorted_atoms:
            result.append(atom)
            if final_map[atom] > 1:
                result.append(str(final_map[atom]))
                
        return "".join(result)

7.              3430. Maximum and Minimum Sums of at Most Size K Subarrays



class Solution:
    def minMaxSubarraySum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        # Helper function to count valid subarrays containing the element
        # given L elements available on left and R elements available on right
        def count_valid_subarrays(L: int, R: int) -> int:
            # We need to count pairs (l, r) such that 0 <= l <= L, 0 <= r <= R and l + r <= k - 1
            max_sum = k - 1
            if max_sum < 0:
                return 0
            
            # Standard combinatorial boundary count for l + r <= max_sum
            total = 0
            # Case 1: If we don't hit the L or R bounds
            # Total non-negative integer pairs (l, r) with l + r <= S is (S + 1) * (S + 2) // 2
            # We use inclusion-exclusion principle to prune configurations exceeding L or R
            def count_pairs(S):
                return (S + 1) * (S + 2) // 2 if S >= 0 else 0
            
            total = count_pairs(max_sum)
            total -= count_pairs(max_sum - (L + 1))
            total -= count_pairs(max_sum - (R + 1))
            total += count_pairs(max_sum - (L + 1) - (R + 1))
            return total

        # --- Calculate Contributions for MINIMUMS ---
        left_min = [0] * n
        right_min = [0] * n
        stack = []
        
        # Elements to the left strictly greater (to avoid double counting, use >)
        for i in range(n):
            while stack and nums[stack[-1]] > nums[i]:
                stack.pop()
            left_min[i] = i - stack[-1] - 1 if stack else i
            stack.append(i)
            
        stack = []
        # Elements to the right greater or equal (use >=)
        for i in range(n - 1, -1, -1):
            while stack and nums[stack[-1]] >= nums[i]:
                stack.pop()
            right_min[i] = stack[-1] - i - 1 if stack else n - i - 1
            stack.append(i)

        # --- Calculate Contributions for MAXIMUMS ---
        left_max = [0] * n
        right_max = [0] * n
        stack = []
        
        # Elements to the left strictly smaller (use <)
        for i in range(n):
            while stack and nums[stack[-1]] < nums[i]:
                stack.pop()
            left_max[i] = i - stack[-1] - 1 if stack else i
            stack.append(i)
            
        stack = []
        # Elements to the right smaller or equal (use <=)
        for i in range(n - 1, -1, -1):
            while stack and nums[stack[-1]] <= nums[i]:
                stack.pop()
            right_max[i] = stack[-1] - i - 1 if stack else n - i - 1
            stack.append(i)

        # --- Aggregate Global Totals ---
        total_sum = 0
        for i in range(n):
            # Minimum element combinations
            min_subarrays = count_valid_subarrays(left_min[i], right_min[i])
            total_sum += min_subarrays * nums[i]
            
            # Maximum element combinations
            max_subarrays = count_valid_subarrays(left_max[i], right_max[i])
            total_sum += max_subarrays * nums[i]
            
        return total_sum


8.          3420. Count Non-Decreasing Subarrays After K Operations



from collections import deque

class Solution:
    def countNonDecreasingSubarrays(self, nums: list[int], k: int) -> int:
        n = len(nums)
        ans = 0
        current_ops = 0
        
        # Deque stores indices of elements in a strictly decreasing order of values
        # deque[0] will track the index of the maximum element in the current window
        dq = deque()
        
        # Right boundary pointer of our valid sliding window
        R = n - 1
        
        # Slide the Left pointer 'L' backwards from right to left
        for L in range(n - 1, -1, -1):
            # 1. Maintain decreasing queue and calculate operational cost added by nums[L]
            # While the new left element is greater than or equal to elements in the deque,
            # it becomes the new maximum for those segments. We calculate the cost delta.
            while dq and nums[L] >= nums[dq[-1]]:
                popped_idx = dq.pop()
                
                # Determine the right bound of the segment controlled by popped_idx
                next_idx = dq[-1] if dq else R + 1
                
                # The elements from popped_idx to next_idx - 1 were previously padded up to nums[popped_idx].
                # They must now be padded up to nums[L].
                current_ops += (next_idx - popped_idx) * (nums[L] - nums[popped_idx])
            
            # Add the current left index to the monotonic tracking queue
            dq.append(L)
            
            # 2. If total operations exceed k, shrink the right pointer R from the tail
            while current_ops > k:
                # The element at R is losing its padding because it is leaving the window
                # It was padded up to the maximum value active at that position, which is nums[dq[0]]
                current_ops -= nums[dq[0]] - nums[R]
                
                # If R matches the maximum index element, remove it from the tracking queue
                if dq[0] == R:
                    dq.popleft()
                    
                R -= 1
                
            # 3. Add the number of valid subarrays starting at index L
            # Every subarray from L to any ending index between L and R is valid
            ans += (R - L + 1)
            
        return ans

9.             3229. Minimum Operations to Make Array Equal to Target


class Solution:
    def minimumOperations(self, nums: list[int], target: list[int]) -> int:
        n = len(nums)
        # Calculate the net difference needed for each position
        diff = [target[i] - nums[i] for i in range(n)]
        
        total_operations = 0
        prev_diff = 0
        
        for current_diff in diff:
            # Check if the sign has changed between the previous and current element
            # (i.e., one needs increments and the other needs decrements)
            if (current_diff > 0 and prev_diff < 0) or (current_diff < 0 and prev_diff > 0):
                # Sign changed: we cannot reuse any operations from the previous element
                total_operations += abs(current_diff)
            else:
                # Same sign or coming from a 0 difference:
                # We only need to add extra operations if the current demand exceeds the previous demand
                if abs(current_diff) > abs(prev_diff):
                    total_operations += abs(current_diff) - abs(prev_diff)
            
            # Update the previous difference tracking variable
            prev_diff = current_diff
            
        return total_operations



10. 3113. Find the Number of Subarrays Where Boundary Elements Are Maximum


class Solution:
    def numberOfSubarrays(self, nums: list[int]) -> int:
        # Stack stores pairs of [value, count_of_this_value]
        # It maintains a strictly decreasing order of values
        stack = []
        ans = 0
        
        for num in nums:
            # Maintain the decreasing property of the stack.
            # Any element smaller than 'num' can no longer serve as a valid maximum boundary
            while stack and stack[-1][0] < num:
                stack.pop()
                
            # If the current number matches the top of the stack,
            # it extends the valid subarrays formed by previous occurrences.
            if stack and stack[-1][0] == num:
                stack[-1][1] += 1
            else:
                # First time seeing this number in the current valid scope
                stack.append([num, 1])
                
            # Add the number of valid subarrays ending at the current index.
            # This equals the total occurrences of 'num' currently tracked in our stack pair.
            ans += stack[-1][1]
            
        return ans






