1.      71. Simplify Path




class Solution:
    def simplifyPath(self, path: str) -> str:
        # Split the path by slashes to isolate directory names and symbols
        components = path.split('/')
        stack = []
        
        for component in components:
            # Skip empty strings (from multiple slashes like '//') or current directory '.'
            if component == '' or component == '.':
                continue
            # If parent directory '..', pop from stack if it is not empty
            elif component == '..':
                if stack:
                    stack.pop()
            # Valid directory or file names (including '...', '....', etc.)
            else:
                stack.append(component)
                
        # Reconstruct the canonical path starting with a single leading slash
        return '/' + '/'.join(stack)



2.              114. Flatten Binary Tree to Linked List


# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right

class Solution:
    def flatten(self, root: Optional[TreeNode]) -> None:
        """
        Do not return anything, modify root in-place instead.
        """
        curr = root
        
        while curr:
            # If there is a left subtree, we need to wire it correctly
            if curr.left:
                # Find the rightmost node of the left subtree
                prev = curr.left
                while prev.right:
                    prev = prev.right
                
                # Connect the rightmost node of the left subtree to current's right child
                prev.right = curr.right
                
                # Move the entire left subtree to the right side
                curr.right = curr.left
                curr.left = None  # Crucial: set left pointer to None
            
            # Move on to the next node on the right
            curr = curr.right



3.              143. Reorder List




# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next

class Solution:
    def reorderList(self, head: Optional[ListNode]) -> None:
        """
        Do not return anything, modify head in-place instead.
        """
        if not head or not head.next:
            return
        
        # Step 1: Find the middle of the linked list using slow and fast pointers
        slow, fast = head, head
        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next
            
        # Step 2: Reverse the second half of the list starting from slow.next
        prev, curr = None, slow.next
        slow.next = None  # Sever the connection between first and second half
        
        while curr:
            nxt = curr.next
            curr.next = prev
            prev = curr
            curr = nxt
            
        # Step 3: Merge the two halves alternatingly
        first, second = head, prev
        while second:
            tmp1, tmp2 = first.next, second.next
            
            first.next = second
            second.next = tmp1
            
            first = tmp1
            second = tmp2

4.   227. Basic Calculator II




class Solution:
    def calculate(self, s: str) -> int:
        if not s:
            return 0
            
        stack = []
        current_number = 0
        last_operator = '+'
        
        # Add a dummy character at the end to force processing of the last number
        for i, char in enumerate(s):
            if char.isdigit():
                current_number = (current_number * 10) + int(char)
                
            # If the character is an operator or we reached the end of the string
            if char in '+-*/' or i == len(s) - 1:
                if last_operator == '+':
                    stack.append(current_number)
                elif last_operator == '-':
                    stack.append(-current_number)
                elif last_operator == '*':
                    stack.append(stack.pop() * current_number)
                elif last_operator == '/':
                    # Integer division in Python towards zero for negative numbers
                    top = stack.pop()
                    if top < 0:
                        stack.append(-(-top // current_number))
                    else:
                        stack.append(top // current_number)
                        
                # Update operator and reset current number
                last_operator = char
                current_number = 0
                
        return sum(stack)


5.              385. Mini Parser




class Solution:
    def deserialize(self, s: str) -> NestedInteger:
        # Case 1: The string is just a single integer (does not start with '[')
        if not s.startswith('['):
            return NestedInteger(int(s))
            
        stack = []
        num_str = ""
        
        for char in s:
            if char == '[':
                # Start of a new list container
                stack.append(NestedInteger())
            elif char == ']':
                # If there's a buffered number string, finalize and add it to the active list
                if num_str:
                    stack[-1].add(NestedInteger(int(num_str)))
                    num_str = ""
                # This nested list layer is complete
                completed_list = stack.pop()
                if stack:
                    # If a parent list exists, add this completed list into it
                    stack[-1].add(completed_list)
                else:
                    # The root list is finished and popped
                    return completed_list
            elif char == ',':
                # Commas signify the end of a number component within the current layer
                if num_str:
                    stack[-1].add(NestedInteger(int(num_str)))
                    num_str = ""
            else:
                # Accumulate digit characters and negative signs
                num_str += char
                
        return None

6.          394. Decode String



class Solution:
    def decodeString(self, s: str) -> str:
        stack = []
        current_string = ""
        current_num = 0
        
        for char in s:
            if char.isdigit():
                # Build the multi-digit multiplier (e.g., '100')
                current_num = current_num * 10 + int(char)
                
            elif char == '[':
                # Push the context we built so far onto the stack
                stack.append((current_string, current_num))
                # Reset for the new internal nested string context
                current_string = ""
                current_num = 0
                
            elif char == ']':
                # Decode the completed layer
                last_string, num = stack.pop()
                # Multiply the current string layer and append it to the parent layer
                current_string = last_string + (num * current_string)
                
            else:
                # Append standard letters to our active working string
                current_string += char
                
        return current_string


7.          456. 132 Pattern



class Solution:
    def find132pattern(self, nums: list[int]) -> bool:
        # This variable stores the best candidate for '2' (nums[k])
        nums_k = float('-inf')
        stack = []
        
        # Traverse from right to left to find '3' (nums[j]) and '2' (nums[k])
        for i in range(len(nums) - 1, -1, -1):
            # If we find a number smaller than nums_k, we found our '1' (nums[i])
            if nums[i] < nums_k:
                return True
            
            # Maintain a monotonic decreasing stack
            # If the current number is greater than the stack top, it acts as '3'
            while stack and nums[i] > stack[-1]:
                # The popped element becomes the largest possible '2'
                nums_k = stack.pop()
                
            # Push the current number as a candidate for '3' or '2'
            stack.append(nums[i])
            
        return False

8.      581. Shortest Unsorted Continuous Subarray



class Solution:
    def findUnsortedSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1:
            return 0
        
        # Track boundaries of the unsorted subarray
        start = -1
        end = -2  # Initialized so that end - start + 1 equals 0 if already sorted
        
        # Track max from left to right, and min from right to left
        max_seen = float('-inf')
        min_seen = float('inf')
        
        # Single pass to find both boundaries
        for i in range(n):
            # Left to right: find the last element smaller than the max seen so far
            max_seen = max(max_seen, nums[i])
            if nums[i] < max_seen:
                end = i
                
            # Right to left: find the first element larger than the min seen so far
            r_idx = n - 1 - i
            min_seen = min(min_seen, nums[r_idx])
            if nums[r_idx] > min_seen:
                start = r_idx
                
        return end - start + 1

9.              678. Valid Parenthesis String



class Solution:
    def checkValidString(self, s: str) -> bool:
        # Track the minimum and maximum possible open '(' count
        cmin, cmax = 0, 0
        
        for char in s:
            if char == '(':
                cmin += 1
                cmax += 1
            elif char == ')':
                cmin -= 1
                cmax -= 1
            else: # char == '*'
                cmin -= 1  # Treated as ')'
                cmax += 1  # Treated as '('
                
            # If cmax drops below 0, it means we have too many close parentheses ')'
            if cmax < 0:
                return False
                
            # cmin cannot be negative because we can't have "negative" open brackets.
            # If it drops below 0, we treat some '*' as empty strings instead of ')'.
            cmin = max(cmin, 0)
            
        # If 0 is within our valid open bracket range, the string is valid
        return cmin == 0



10.         769. Max Chunks To Make Sorted


class Solution:
    def maxChunksToSorted(self, arr: list[int]) -> int:
        chunks = 0
        max_seen = 0
        
        for i, val in enumerate(arr):
            # Track the maximum value seen in the current chunk
            max_seen = max(max_seen, val)
            
            # If the max value matches the current index, we can close the chunk
            if max_seen == i:
                chunks += 1
                
        return chunks
