6.          2327. Number of People Aware of a Secret



class Solution:
    def peopleAwareOfSecret(self, n: int, delay: int, forget: int) -> int:
        MOD = 10**9 + 7
        
       
        dp = [0] * (n + 1)
        dp[1] = 1 
       
        sharing_count = 0
        
        for i in range(2, n + 1):
           
            if i - delay >= 1:
                sharing_count = (sharing_count + dp[i - delay]) % MOD
                
           
            if i - forget >= 1:
                sharing_count = (sharing_count - dp[i - forget] + MOD) % MOD
                
           
            dp[i] = sharing_count
            
        
        total_people = 0
        for i in range(max(1, n - forget + 1), n + 1):
            total_people = (total_people + dp[i]) % MOD
            
        return total_people



7.              2526. Find Consecutive Integers from a Data Stream



class DataStream:

    def __init__(self, value: int, k: int):
        self.target_value = value
        self.required_count = k
        self.consecutive_count = 0

    def consec(self, num: int) -> bool:
        # If the number matches our target value, increment the counter
        if num == self.target_value:
            self.consecutive_count += 1
        else:
            # If a different number breaks the streak, reset the counter to 0
            self.consecutive_count = 0
            
        # Return True only if we have seen at least k consecutive target values
        return self.consecutive_count >= self.required_count



8.          2762. Continuous Subarrays



from collections import deque
from typing import List

class Solution:
    def continuousSubarrays(self, nums: List[int]) -> int:
        # Monotonic deques to track indices of the max and min values in the window
        max_dq = deque()
        min_dq = deque()
        
        left = 0
        total_subarrays = 0
        
        for right, num in enumerate(nums):
            # Maintain decreasing order in max_dq (stores indices of maximums)
            while max_dq and nums[max_dq[-1]] <= num:
                max_dq.pop()
            max_dq.append(right)
            
            # Maintain increasing order in min_dq (stores indices of minimums)
            while min_dq and nums[min_dq[-1]] >= num:
                min_dq.pop()
            min_dq.append(right)
            
            # Shrink the window from the left if the maximum difference exceeds 2
            while nums[max_dq[0]] - nums[min_dq[0]] > 2:
                left += 1
                # Remove indices that fall outside the active sliding window
                if max_dq[0] < left:
                    max_dq.popleft()
                if min_dq[0] < left:
                    min_dq.popleft()
                    
            # The number of valid subarrays ending at the current 'right' index
            total_subarrays += (right - left + 1)
            
        return total_subarrays





9.          2944. Minimum Number of Coins for Fruits
    


from functools import lru_cache
from typing import List

class Solution:
    def minimumCoins(self, prices: List[int]) -> int:
        n = len(prices)
        
        @lru_cache(None)
        def dp(i: int) -> int:
            
            if i >= n:
                return 0
                
            
            if i + (i + 1) >= n:
                return prices[i]
                
          
            min_cost = float('inf')
            max_free_index = i + (i + 1)
            
            for next_buy in range(i + 1, max_free_index + 2):
                min_cost = min(min_cost, prices[i] + dp(next_buy))
                
            return min_cost

        return dp(0)



10.             3191. Minimum Operations to Make Binary Array Elements Equal to One I




from typing import List

class Solution:
    def minOperations(self, nums: List[int]) -> int:
        n = len(nums)
        operations = 0
        
        # Iterate up to the third-to-last element
        for i in range(n - 2):
            # If the current element is 0, we are forced to flip it
            if nums[i] == 0:
                nums[i] = 1
                nums[i + 1] = 1 - nums[i + 1]
                nums[i + 2] = 1 - nums[i + 2]
                operations += 1
                
        # Check the last two elements. If either is still 0, it's impossible.
        if nums[n - 1] == 0 or nums[n - 2] == 0:
            return -1
            
        return operations




