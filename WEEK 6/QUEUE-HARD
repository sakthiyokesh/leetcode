1.          862. Shortest Subarray with Sum at Least K


from collections import deque
from typing import List

class Solution:
    def shortestSubarray(self, nums: List[int], k: int) -> int:
        n = len(nums)
       
        prefix_sums = [0] * (n + 1)
        for i in range(n):
            prefix_sums[i + 1] = prefix_sums[i] + nums[i]
            
        
        dq = deque()
        min_length = float('inf')
        
        for i, curr_sum in enumerate(prefix_sums):
           
            while dq and curr_sum - prefix_sums[dq[0]] >= k:
                min_length = min(min_length, i - dq.popleft())
                
         
            
        return min_length if min_length != float('inf') else -1





2.              995. Minimum Number of K Consecutive Bit Flips



from typing import List

class Solution:
    def minKBitFlips(self, nums: List[int], k: int) -> int:
        n = len(nums)
        total_flips = 0
        current_window_flips = 0
        
        for i in range(n):
          
            if i >= k and nums[i - k] > 1:
                current_window_flips -= 1
              
                nums[i - k] -= 2
                
         
            if (nums[i] + current_window_flips) % 2 == 0:
              
                if i + k > n:
                    return -1
                
                
                current_window_flips += 1
                total_flips += 1
                
                
                nums[i] += 2
                
        return total_flips





3.              1425. Constrained Subsequence Sum



from collections import deque
from typing import List

class Solution:
    def constrainedSubsetSum(self, nums: List[int], k: int) -> int:
   
        dp = nums[:]
        
      
        dq = deque()
        
        max_sum = nums[0]
        
        for i in range(len(nums)):
         
            if dq and dq[0] < i - k:
                dq.popleft()
                
           
            if dq:
                dp[i] = max(dp[i], nums[i] + dp[dq[0]])
                
          
            max_sum = max(max_sum, dp[i])
            
            
            while dq and dp[dq[-1]] <= dp[i]:
                dq.pop()
                
           
            dq.append(i)
            
        return max_sum



4.              1499. Max Value of Equation


from collections import deque
from typing import List

class Solution:
    def findMaxValueOfEquation(self, points: List[List[int]], k: int) -> int:
        
        dq = deque()
        max_val = float('-inf')
        
        for x, y in points:
         
            while dq and x - dq[0][1] > k:
                dq.popleft()
                
            
            if dq:
                max_val = max(max_val, dq[0][0] + y + x)
                
           
            current_diff = y - x
            while dq and dq[-1][0] <= current_diff:
                dq.pop()
                
           
            dq.append((current_diff, x))
            
        return max_val





5.          1687. Delivering Boxes from Storage to Ports



from collections import deque
from typing import List

class Solution:
    def boxDelivering(self, boxes: List[List[int]], portsCount: int, maxBoxes: int, maxWeight: int) -> int:
        n = len(boxes)
        
        
        dp = [0] * (n + 1)
        
       
        left = 0
        current_weight = 0
        consecutive_trips = 0
        
       
        dq = deque([0])
        
        for right in range(1, n + 1):
           
            current_weight += boxes[right - 1][1]
            
           
            if right > 1 and boxes[right - 1][0] != boxes[right - 2][0]:
                consecutive_trips += 1
                
           
            while right - left > maxBoxes or current_weight > maxWeight:
                current_weight -= boxes[left][1]
                if left + 1 < n and boxes[left][0] != boxes[left + 1][0]:
                    consecutive_trips -= 1
                left += 1
                
          
            while dq and dq[0] < left:
                dq.popleft()
                
     
            best_j = dq[0]
            dp[right] = dp[best_j] + consecutive_trips - (consecutive_trips if best_j > 0 else 0) + 2
            
            
            if right < n and boxes[right - 1][0] == boxes[right][0]:
               
                pass
                
          
            if right < n:
               
                current_cost = dp[right] - consecutive_trips
                
                while dq:
                    prev_j = dq[-1]
                    prev_cost = dp[prev_j] - (consecutive_trips if prev_j > 0 else 0)
                    if prev_cost >= current_cost:
                        dq.pop()
                    else:
                        break
                dq.append(right)
                
        return dp[n]




6.              2071. Maximum Number of Tasks You Can Assign


from collections import deque
from typing import List

class Solution:
    def maxTaskAssign(self, tasks: List[int], workers: List[int], pills: int, strength: int) -> int:
        # Sort both arrays to facilitate greedy selections
        tasks.sort()
        workers.sort()
        
        def check(count: int) -> bool:
   
            active_tasks = tasks[:count]
          
            active_workers = workers[-count:]
            
            dq = deque()
            
            worker_idx = len(active_workers) - 1
            pills_left = pills
            
          
            for task in reversed(active_tasks):
                
                while worker_idx >= 0 and active_workers[worker_idx] + strength >= task:
                   
                    dq.appendleft(active_workers[worker_idx])
                    worker_idx -= 1
                    
                
                if not dq:
                    return False
                    
                
                if dq[-1] >= task:
                    dq.pop()
               
                else:
                    if pills_left == 0:
                        return False
                    pills_left -= 1
                    dq.popleft()
                    
            return True

        
        low = 0
        high = min(len(tasks), len(workers))
        ans = 0
        
        while low <= high:
            mid = (low + high) // 2
            if check(mid):
                ans = mid
                low = mid + 1 
            else:
                high = mid - 1
                
        return ans


7.                  2398. Maximum Number of Robots Within Budget




from collections import deque
from typing import List

class Solution:
    def maximumRobots(self, chargeTimes: List[int], runningCosts: List[int], budget: int) -> int:
        n = len(chargeTimes)
        
      
        max_dq = deque()
        
        left = 0
        current_running_sum = 0
        max_robots = 0
        
        for right in range(n):
         
            current_running_sum += runningCosts[right]
            
           
            while max_dq and chargeTimes[max_dq[-1]] <= chargeTimes[right]:
                max_dq.pop()
            max_dq.append(right)
            
            
            while max_dq and (chargeTimes[max_dq[0]] + (right - left + 1) * current_running_sum) > budget:
              
                current_running_sum -= runningCosts[left]
                
                
                if max_dq[0] == left:
                    max_dq.popleft()
                    
                left += 1
                
           
            max_robots = max(max_robots, right - left + 1)
            
        return max_robots



