9.          2528. Maximize the Minimum Powered City



from typing import List

class Solution:
    def maxPower(self, stations: List[int], r: int, k: int) -> int:
        n = len(stations)
        
        
        initial_power = [0] * n
        current_window_sum = 0
        
      
        for i in range(min(n, r + 1)):
            current_window_sum += stations[i]
        initial_power[0] = current_window_sum
        
       
        for i in range(1, n):
            
            if i + r < n:
                current_window_sum += stations[i + r]
           
            if i - r - 1 >= 0:
                current_window_sum -= stations[i - r - 1]
            initial_power[i] = current_window_sum

        def check(target_min: int) -> bool:
            """
            Checks if it's possible to make the power of every city 
            at least 'target_min' by adding at most 'k' power stations.
            """
            
            diff = [0] * (n + 1)
            added_stations_count = 0
            stations_built_so_far = 0
            
            for i in range(n):
                
                stations_built_so_far += diff[i]
                
               
                current_power = initial_power[i] + stations_built_so_far
                
                if current_power < target_min:
                    needed = target_min - current_power
                    added_stations_count += needed
                    
                    if added_stations_count > k:
                        return False
                    
                   
                    best_placement_idx = min(n - 1, i + r)
                    
                   
                    stations_built_so_far += needed
                  
                    if best_placement_idx + r + 1 < n:
                        diff[best_placement_idx + r + 1] -= needed
                        
            return True

       
        low = min(initial_power)
       
        high = max(initial_power) + k
        ans = low
        
        while low <= high:
            mid = (low + high) // 2
            if check(mid):
                ans = mid
                low = mid + 1  
            else:
                high = mid - 1
                
        return ans



10.             2945. Find Maximum Non-decreasing Array Length



from collections import deque
from typing import List

class Solution:
    def findMaximumLength(self, nums: List[int]) -> int:
        n = len(nums)
        
       
        prefix_sums = [0] * (n + 1)
        for i in range(n):
            prefix_sums[i + 1] = prefix_sums[i] + nums[i]
       
        dp = [0] * (n + 1)
        
        #
        last_element_val = [0] * (n + 1)
        
        
        dq = deque([0])
        
        for i in range(1, n + 1):

             best_j = 0
            
            
            
            while dq and prefix_sums[i] >= prefix_sums[dq[0]] + last_element_val[dq[0]]:
                best_j = dq.popleft()
            
            dp[i] = dp[best_j] + 1
            last_element_val[i] = prefix_sums[i] - prefix_sums[best_j]
            
           
            dq.appendleft(best_j)
            
           
            current_requirement = prefix_sums[i] + last_element_val[i]
            while dq and (prefix_sums[dq[-1]] + last_element_val[dq[-1]]) >= current_requirement:
                dq.pop()
                
            dq.append(i)
            
        return dp[n]
